# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=bitwise
APP_NAME=FinCore AI API
ENVIRONMENT=development
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-fernet-key
# Create at console.x.ai. Leave blank until Phase 5 is tested.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
